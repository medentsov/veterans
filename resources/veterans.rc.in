// Ресурсы Windows: версия, иконка и манифест DPI (M11-03).
// Файл генерируется CMake из resources/veterans.rc.in:
//   @PROJECT_VERSION_MAJOR@ и т. п. подставляет configure_file.
#include <windows.h>

IDI_ICON1 ICON "@VETERANS_ICON_PATH@"

// RT_MANIFEST = 24: манифест DPI и уровень прав.
1 24 "@VETERANS_MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Veterans"
            VALUE "FileDescription", "Veterans registry"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Veterans"
            VALUE "OriginalFilename", "Veterans.exe"
            VALUE "ProductName", "Veterans"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
