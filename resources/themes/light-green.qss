/* Зелёная светлая тема */
QWidget {
    color: #1F2E24;
}
QMainWindow, QDialog {
    background-color: #F3FAF4;
}
QMenuBar {
    background-color: #E6F3E9;
    color: #1F2E24;
}
QMenuBar::item:selected {
    background-color: #D2EBD8;
}
QMenu {
    background-color: #FCFEFC;
    border: 1px solid #B8D6C0;
}
QMenu::item:selected {
    background-color: #D2EBD8;
}
QToolBar {
    background-color: #E6F3E9;
    border: none;
    spacing: 4px;
}
QToolButton {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}
QToolButton:hover {
    background-color: #D2EBD8;
}
QToolButton:pressed {
    background-color: #BEE0C7;
}
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    background-color: #FCFEFC;
    border: 1px solid #A9CDB4;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #2E7D4F;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border: 1px solid #2E7D4F;
}
QPushButton {
    background-color: #2E7D4F;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #3A9460;
}
QPushButton:pressed {
    background-color: #236640;
}
QPushButton:disabled {
    background-color: #C9DECF;
    color: #7C8F82;
}
QTableView {
    background-color: #FCFEFC;
    alternate-background-color: #EAF6ED;
    gridline-color: #D0E6D6;
    selection-background-color: #2E7D4F;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background-color: #D8EEDD;
    color: #1F2E24;
    border: none;
    border-right: 1px solid #B8D6C0;
    border-bottom: 1px solid #B8D6C0;
    padding: 5px;
    font-weight: bold;
}
QStatusBar {
    background-color: #E6F3E9;
    color: #556B5C;
}
QTabWidget::pane {
    border: 1px solid #B8D6C0;
}
QTabBar::tab {
    background-color: #DFF0E4;
    padding: 6px 12px;
    border: 1px solid #B8D6C0;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #FCFEFC;
}
QGroupBox {
    border: 1px solid #B8D6C0;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
