/* Холодная светлая тема */
QWidget {
    color: #1F2A33;
}
QMainWindow, QDialog {
    background-color: #F4F8FC;
}
QMenuBar {
    background-color: #E8F0F8;
    color: #1F2A33;
}
QMenuBar::item:selected {
    background-color: #D6E5F3;
}
QMenu {
    background-color: #FCFDFF;
    border: 1px solid #B9CCDE;
}
QMenu::item:selected {
    background-color: #D6E5F3;
}
QToolBar {
    background-color: #E8F0F8;
    border: none;
    spacing: 4px;
}
QToolButton {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}
QToolButton:hover {
    background-color: #D6E5F3;
}
QToolButton:pressed {
    background-color: #C3D7EA;
}
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    background-color: #FCFDFF;
    border: 1px solid #AFC5D8;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #2F6FA8;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border: 1px solid #2F6FA8;
}
QPushButton {
    background-color: #2F6FA8;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #3D80BC;
}
QPushButton:pressed {
    background-color: #255B8C;
}
QPushButton:disabled {
    background-color: #C9D6E2;
    color: #7A8B9A;
}
QTableView {
    background-color: #FCFDFF;
    alternate-background-color: #EDF4FA;
    gridline-color: #D2E0EC;
    selection-background-color: #2F6FA8;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background-color: #DCE9F5;
    color: #1F2A33;
    border: none;
    border-right: 1px solid #B9CCDE;
    border-bottom: 1px solid #B9CCDE;
    padding: 5px;
    font-weight: bold;
}
QStatusBar {
    background-color: #E8F0F8;
    color: #56697A;
}
QTabWidget::pane {
    border: 1px solid #B9CCDE;
}
QTabBar::tab {
    background-color: #E2EDF7;
    padding: 6px 12px;
    border: 1px solid #B9CCDE;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #FCFDFF;
}
QGroupBox {
    border: 1px solid #B9CCDE;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
